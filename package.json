{
  "name": "character-todo-google",
  "version": "2.6.18",
  "description": "Character Todo app integrating with Google Gemini AI",
  "main": "src/main.js",
  "private": true,
  "scripts": {
    "start": "powershell -ExecutionPolicy Bypass -File ./run-app.ps1",
    "lint:js": "node --check src/main.js && node --check src/preload.js && node --check src/renderer.js",
    "dist": "powershell -ExecutionPolicy Bypass -File ./build-exe.ps1"
  },
  "build": {
    "appId": "com.gogolebi.characterTodoGoogle",
    "productName": "Character Todo Google",
    "artifactName": "Character-Todo-Google-Setup-${version}.${ext}",
    "copyright": "Copyright © 2026",
    "win": {
      "verifyUpdateCodeSignature": false,
      "requestedExecutionLevel": "asInvoker",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "cybereun",
        "repo": "character-todo-google"
      }
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "build/icon.ico",
      "package.json",
      "README.md",
      "credentials.json"
    ],
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "packElevateHelper": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Character Todo Google",
      "license": "build/license.txt",
      "language": "1042",
      "runAfterFinish": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerSidebar": "build/installerSidebar.bmp",
      "uninstallerSidebar": "build/installerSidebar.bmp",
      "installerHeader": "build/installerHeader.bmp",
      "installerHeaderIcon": "build/icon.ico",
      "include": "build/installer.nsh"
    }
  },
  "devDependencies": {
    "electron": "31.7.7",
    "electron-builder": "^25.1.8"
  },
  "dependencies": {
    "electron-updater": "^6.3.9",
    "googleapis": "^173.0.0"
  }
}
